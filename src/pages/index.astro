---
import Layout from '../layouts/Layout.astro';
import Cta from '../components/Cta.astro';
---

<Layout title="Web design, development & marketing | GSWebIT">
  <main>
    <section class="blue hero">
      <div class="wrap hero-in">
        <div>
          <p class="eyebrow rv" style="--d:.05s">Full-service web development agency</p>
          <h1 class="rv" style="--d:.15s">
            We design, build, and grow websites that work for your business.
          </h1>
          <p class="lead rv" style="--d:.28s">
            Web design, development, digital marketing, WordPress, and Odoo, all under one roof. One accountable team for your entire web presence, from the first idea to launch and beyond.
          </p>
          <div class="btns rv" style="--d:.4s">
            <a class="btn wht" href="/contact">Inquire now</a>
            <a class="btn out" href="/services">Explore our services</a>
          </div>
        </div>
        <div class="art rv" style="--d:.3s">
          <img
            src="/assets/img/hero.svg"
            width="4743"
            height="3162"
            alt="Developer designing a mobile website layout at a desk"
            fetchpriority="high"
            decoding="async"
          />
        </div>
      </div>
    </section>

    <section class="sec">
      <div class="wrap">
        <div class="head c">
          <h2>Full-stack web services, one team</h2>
          <p class="sub">
            Eight specialised services under one roof. Start with what you need, or let us handle your whole web journey.
          </p>
        </div>
        <div class="grid g3">
          <a class="card" id="web-design" href="/services#web-design">
            <span class="ico" data-ico="design"></span>
            <h3>Web Design</h3>
            <p>Modern, conversion-focused interfaces designed around your brand and your customers.</p>
            <span class="more">Learn more</span>
          </a>
          <a class="card" id="web-development" href="/services#web-development">
            <span class="ico" data-ico="dev"></span>
            <h3>Web Development</h3>
            <p>Fast, secure, scalable websites and web applications built on the right technology.</p>
            <span class="more">Learn more</span>
          </a>
          <a class="card" id="digital-marketing" href="/services#digital-marketing">
            <span class="ico" data-ico="mkt"></span>
            <h3>Digital Marketing</h3>
            <p>SEO, paid, content, and social strategies that turn traffic into revenue.</p>
            <span class="more">Learn more</span>
          </a>
          <a class="card" id="ai-seo" href="/services#ai-seo">
            <span class="ico" data-ico="aiseo"></span>
            <h3>AI SEO</h3>
            <p>Make AI search engines crawl your site and recommend your brand to high-intent users.</p>
            <span class="more">Learn more</span>
          </a>
          <a class="card" id="google-maps" href="/services#google-maps">
            <span class="ico" data-ico="maps"></span>
            <h3>Google Profile & Maps</h3>
            <p>Dominate local search rankings and Google Maps to drive nearby calls, visits, and sales.</p>
            <span class="more">Learn more</span>
          </a>
          <a class="card" id="odoo" href="/services#odoo">
            <span class="ico" data-ico="odoo"></span>
            <h3>Odoo</h3>
            <p>Implement and customise Odoo ERP to streamline your sales, inventory, and accounting.</p>
            <span class="more">Learn more</span>
          </a>
          <a class="card" id="wordpress" href="/services#wordpress">
            <span class="ico" data-ico="wp"></span>
            <h3>WordPress Development</h3>
            <p>Custom themes, plugins, and e-commerce on the world's most flexible platform.</p>
            <span class="more">Learn more</span>
          </a>
          <a class="card" id="support" href="/services#support">
            <span class="ico" data-ico="sup"></span>
            <h3>Support & Maintenance</h3>
            <p>Ongoing care, updates, and performance so your website keeps working at its best.</p>
            <span class="more">Learn more</span>
          </a>
        </div>
      </div>
    </section>

    <section class="sec tint">
      <div class="wrap">
        <div class="stats">
          <div><b>120+</b><span>Projects delivered</span></div>
          <div><b>5+</b><span>Years of experience</span></div>
          <div><b>99%</b><span>Client satisfaction</span></div>
          <div><b>40+</b><span>Clients served</span></div>
        </div>
      </div>
    </section>

    <section class="sec blue">
      <div class="wrap">
        <div class="head c">
          <h2>A clear path from idea to launch</h2>
        </div>
        <div class="steps">
          <div>
            <small>1</small>
            <h3>Discover</h3>
            <p>We start by understanding your goals, audience, and requirements so we build the right thing.</p>
          </div>
          <div>
            <small>2</small>
            <h3>Design</h3>
            <p>We craft layouts and visual direction tailored to your brand and your customers.</p>
          </div>
          <div>
            <small>3</small>
            <h3>Develop</h3>
            <p>We build fast, secure, scalable websites and systems on the right platform for you.</p>
          </div>
          <div>
            <small>4</small>
            <h3>Launch & grow</h3>
            <p>We launch, test, and support, and keep improving your results over time.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="sec tint">
      <div class="wrap">
        <div class="head c">
          <h2>Projects that move businesses forward</h2>
          <p class="sub">
            A selection of the websites we've designed and built. Open any one for a full live preview.
          </p>
        </div>
        <div class="grid g3">
          <article class="proj tpl" data-cat="biz">
            <div class="pic">
              <div class="frame" data-w="1280" data-h="853">
                <iframe src="/demos/harbor/" title="Harbor template preview" loading="lazy" tabindex="-1" aria-hidden="true"></iframe>
              </div>
              <a class="pic-link" href="/demos/harbor/" aria-label="Open live preview of Harbor"></a>
            </div>
            <div class="txt">
              <p class="kind">Café, salon, clinic or shop</p>
              <h3>Harbor</h3>
              <p>A bright, animated one-page site for neighbourhood businesses: menu or price list, photo gallery, reviews, opening hours and a booking form.</p>
              <div class="tags">
                <span class="tag">PHP</span>
                <span class="tag">Booking form</span>
                <span class="tag">Opening hours</span>
              </div>
              <div class="acts">
                <a class="btn line" href="/demos/harbor/">Live preview</a>
                <a class="btn acc" href="/contact?template=harbor">Get this template</a>
              </div>
            </div>
          </article>

          <article class="proj tpl" data-cat="personal">
            <div class="pic">
              <div class="frame" data-w="1280" data-h="853">
                <iframe src="/demos/pulse/" title="Pulse template preview" loading="lazy" tabindex="-1" aria-hidden="true"></iframe>
              </div>
              <a class="pic-link" href="/demos/pulse/" aria-label="Open live preview of Pulse"></a>
            </div>
            <div class="txt">
              <p class="kind">Creator & influencer media kit</p>
              <h3>Pulse</h3>
              <p>A dark, bento-style portfolio for creators: latest content, audience stats, rate card, brand logos and a collab enquiry form.</p>
              <div class="tags">
                <span class="tag">PHP</span>
                <span class="tag">Media kit</span>
                <span class="tag">Dark theme</span>
              </div>
              <div class="acts">
                <a class="btn line" href="/demos/pulse/">Live preview</a>
                <a class="btn acc" href="/contact?template=pulse">Get this template</a>
              </div>
            </div>
          </article>

          <article class="proj tpl" data-cat="biz">
            <div class="pic">
              <div class="frame" data-w="1280" data-h="853">
                <iframe src="/demos/nova/" title="Studio Nova template preview" loading="lazy" tabindex="-1" aria-hidden="true"></iframe>
              </div>
              <a class="pic-link" href="/demos/nova/" aria-label="Open live preview of Studio Nova"></a>
            </div>
            <div class="txt">
              <p class="kind">Brand & agency studio</p>
              <h3>Studio Nova</h3>
              <p>A clean brand template with a bold hero, services, work gallery and contact form. Light or dark theme, every section configurable.</p>
              <div class="tags">
                <span class="tag">PHP</span>
                <span class="tag">Light / dark</span>
                <span class="tag">Config-driven</span>
              </div>
              <div class="acts">
                <a class="btn line" href="/demos/nova/">Live preview</a>
                <a class="btn acc" href="/contact?template=nova">Get this template</a>
              </div>
            </div>
          </article>
        </div>
        <div class="more-row">
          <a class="btn acc" href="/templates">View all templates</a>
        </div>
      </div>
    </section>

    <section class="sec orange">
      <div class="wrap">
        <div class="head c">
          <h2>What our clients say</h2>
        </div>
        <div class="grid g3">
          <figure class="quote">
            <div>★★★★★</div>
            <blockquote>Working with them felt like having an in-house team. They redesigned our site, and enquiries went up within months.</blockquote>
            <figcaption><b>Priya Sharma</b><br />Founder, Northstar Retail</figcaption>
          </figure>
          <figure class="quote">
            <div>★★★★★</div>
            <blockquote>Their Odoo implementation transformed how we run the business. Sales, inventory, and accounting now work as one.</blockquote>
            <figcaption><b>Rajesh Iyer</b><br />Operations Director, Apex Manufacturing</figcaption>
          </figure>
          <figure class="quote">
            <div>★★★★★</div>
            <blockquote>They rebuilt our WordPress site and launched a marketing campaign that finally brought us the traffic we deserved.</blockquote>
            <figcaption><b>Sarah Kim</b><br />Marketing Lead, Brightside Studio</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section class="sec tint">
      <div class="wrap">
        <div class="head c">
          <h2>Frequently asked questions</h2>
          <p class="sub">Answers to the questions we hear most often about starting a project.</p>
        </div>
        <div class="faq">
          <div>
            <button aria-expanded="false">
              <span>How much does a website cost?</span><span>+</span>
            </button>
            <div class="ans">
              <div>
                <p>It depends on scope, platform, and features. We give you a clear, itemised quote after an initial discovery call, so you know exactly what you're paying for before we start.</p>
              </div>
            </div>
          </div>
          <div>
            <button aria-expanded="false">
              <span>How long does a typical project take?</span><span>+</span>
            </button>
            <div class="ans">
              <div>
                <p>Most projects take between four and twelve weeks depending on complexity. We agree on a realistic timeline up front and keep you updated at every milestone.</p>
              </div>
            </div>
          </div>
          <div>
            <button aria-expanded="false">
              <span>Do you offer support after launch?</span><span>+</span>
            </button>
            <div class="ans">
              <div>
                <p>Yes. We offer ongoing support and maintenance plans that cover updates, security, backups, and improvements.</p>
              </div>
            </div>
          </div>
          <div>
            <button aria-expanded="false">
              <span>Can you work with our existing website or platform?</span><span>+</span>
            </button>
            <div class="ans">
              <div>
                <p>Absolutely. We can redesign, rebuild, extend, or migrate an existing site, including WordPress and Odoo.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <Cta bg="blue" />
  </main>
</Layout>

