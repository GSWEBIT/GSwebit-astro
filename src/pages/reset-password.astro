---
export const prerender = false;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <title>Reset Password | GSWebIT</title>
    <link rel="icon" href="/assets/mark.png" />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <style>
      :root {
        --brand: #1f4fd1;
        --brand-d: #1740aa;
        --accent: #ea580c;
        --tint: #eef3fd;
        --mut: #475569;
        --line: #e2e8f0;
      }
      * {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        font: 400 0.95rem/1.5 Inter, system-ui, sans-serif;
        background: var(--tint);
        color: #0f172a;
      }
      button {
        font: 600 0.85rem Inter, sans-serif;
        border: 0;
        border-radius: 0.5rem;
        padding: 0.55rem 0.9rem;
        cursor: pointer;
        background: var(--accent);
        color: #fff;
      }
      button:disabled {
        opacity: 0.6;
        cursor: wait;
      }
      .card {
        max-width: 22rem;
        margin: 12vh auto;
        background: #fff;
        border-radius: 1rem;
        padding: 1.75rem;
        box-shadow: 0 10px 30px rgba(15, 23, 42, 0.08);
      }
      .card h1 {
        margin: 0 0 0.25rem;
        font-size: 1.4rem;
        color: var(--brand);
      }
      .card p {
        margin: 0 0 1rem;
        color: var(--mut);
      }
      input[type='password'] {
        width: 100%;
        padding: 0.65rem 0.8rem;
        border: 1px solid var(--line);
        border-radius: 0.5rem;
        font: inherit;
        margin-bottom: 0.75rem;
        outline: none;
        transition: border-color 0.2s;
      }
      input[type='password']:focus {
        border-color: var(--brand);
        box-shadow: 0 0 0 3px rgba(31, 79, 209, 0.1);
      }
      .err {
        color: #b91c1c;
        font-size: 0.85rem;
        min-height: 1.2em;
        margin: 0.25rem 0 0.5rem;
      }
      .success-card {
        text-align: center;
      }
      .success-card .icon {
        width: 4rem;
        height: 4rem;
        background: #f0fdf4;
        border: 2px solid #bbf7d0;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 1rem;
        font-size: 1.8rem;
        color: #166534;
      }
      .success-card h1 {
        color: #166534;
      }
      .success-card p {
        color: var(--mut);
        margin: 0 0 1.5rem;
      }
      .success-card a {
        display: inline-block;
        background: var(--brand);
        color: #fff;
        text-decoration: none;
        padding: 0.6rem 1.5rem;
        border-radius: 0.5rem;
        font-weight: 600;
        font-size: 0.9rem;
        transition: background 0.2s;
      }
      .success-card a:hover {
        background: var(--brand-d);
      }
      .pw-strength {
        height: 4px;
        border-radius: 2px;
        background: var(--line);
        margin: -0.5rem 0 0.75rem;
        overflow: hidden;
      }
      .pw-strength i {
        display: block;
        height: 100%;
        border-radius: 2px;
        transition:
          width 0.3s,
          background 0.3s;
        width: 0;
      }
      .pw-hint {
        font-size: 0.78rem;
        color: var(--mut);
        margin: -0.5rem 0 0.75rem;
      }
      .expired-card {
        text-align: center;
      }
      .expired-card .icon {
        width: 4rem;
        height: 4rem;
        background: #fef2f2;
        border: 2px solid #fecaca;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 1rem;
        font-size: 1.8rem;
        color: #b91c1c;
      }
      .expired-card h1 {
        color: #b91c1c;
      }
      .expired-card a {
        display: inline-block;
        background: var(--brand);
        color: #fff;
        text-decoration: none;
        padding: 0.6rem 1.5rem;
        border-radius: 0.5rem;
        font-weight: 600;
        font-size: 0.9rem;
        transition: background 0.2s;
      }
      .expired-card a:hover {
        background: var(--brand-d);
      }
      [hidden] {
        display: none !important;
      }
    </style>
  </head>
  <body>
    <!-- Reset Form -->
    <div id="resetForm" class="card" hidden>
      <h1>Reset Password</h1>
      <p>Enter your new admin password</p>
      <input
        type="password"
        id="newPw"
        placeholder="New password"
        autocomplete="new-password"
      />
      <div class="pw-strength"><i id="pwBar"></i></div>
      <div class="pw-hint" id="pwHint">Must be at least 6 characters</div>
      <input
        type="password"
        id="confirmPw"
        placeholder="Confirm password"
        autocomplete="new-password"
      />
      <div class="err" id="rerr"></div>
      <button id="rbtn" style="width:100%">Reset Password</button>
    </div>

    <!-- Success -->
    <div id="successView" class="card success-card" hidden>
      <div class="icon">✓</div>
      <h1>Password Reset!</h1>
      <p>
        Your admin password has been updated successfully. You can now sign in with
        your new password.
      </p>
      <a href="/admin">Go to Admin Login</a>
    </div>

    <!-- Expired / Invalid -->
    <div id="expiredView" class="card expired-card" hidden>
      <div class="icon">✕</div>
      <h1>Link Expired</h1>
      <p style="color:var(--mut);margin:0 0 1.5rem">
        This reset link is invalid or has expired. Please request a new password reset.
      </p>
      <a href="/admin">Back to Admin Login</a>
    </div>

    <!-- No token -->
    <div id="noToken" class="card" style="text-align:center" hidden>
      <h1 style="color:var(--mut)">🔒</h1>
      <p style="margin:0 0 1.5rem">
        No reset token found. Please use the link from your email.
      </p>
      <a
        href="/admin"
        style="color:var(--brand);font-weight:600;text-decoration:none"
        >Go to Admin Login</a
      >
    </div>

    <script is:inline>
      const getApiBase = () => {
        if (window.API_BASE_URL) return window.API_BASE_URL.replace(/\/+$/, '');
        return '';
      };
      const API = getApiBase();
      const $ = (s) => document.querySelector(s);

      // Get token from URL
      const params = new URLSearchParams(window.location.search);
      const token = params.get('token');

      if (!token) {
        $('#noToken').hidden = false;
      } else {
        $('#resetForm').hidden = false;
      }

      // Password strength meter
      $('#newPw').addEventListener('input', () => {
        const pw = $('#newPw').value;
        const bar = $('#pwBar');
        const hint = $('#pwHint');
        let strength = 0;
        if (pw.length >= 6) strength++;
        if (pw.length >= 10) strength++;
        if (/[A-Z]/.test(pw) && /[a-z]/.test(pw)) strength++;
        if (/\d/.test(pw)) strength++;
        if (/[^A-Za-z0-9]/.test(pw)) strength++;

        const colors = ['#ef4444', '#f97316', '#eab308', '#22c55e', '#16a34a'];
        const widths = ['20%', '40%', '60%', '80%', '100%'];
        const labels = ['Too weak', 'Weak', 'Fair', 'Good', 'Strong'];

        if (!pw) {
          bar.style.width = '0';
          hint.textContent = 'Must be at least 6 characters';
          hint.style.color = 'var(--mut)';
        } else {
          const idx = Math.min(strength, 5) - 1;
          bar.style.width = widths[Math.max(0, idx)];
          bar.style.background = colors[Math.max(0, idx)];
          hint.textContent = labels[Math.max(0, idx)];
          hint.style.color = colors[Math.max(0, idx)];
        }
      });

      // Submit reset
      async function resetPassword() {
        const b = $('#rbtn');
        b.disabled = true;
        b.textContent = 'Resetting…';
        $('#rerr').textContent = '';

        const password = $('#newPw').value;
        const confirmPassword = $('#confirmPw').value;

        if (!password || !confirmPassword) {
          $('#rerr').textContent = 'Please fill in both password fields';
          b.disabled = false;
          b.textContent = 'Reset Password';
          return;
        }

        if (password.length < 6) {
          $('#rerr').textContent = 'Password must be at least 6 characters';
          b.disabled = false;
          b.textContent = 'Reset Password';
          return;
        }

        if (password !== confirmPassword) {
          $('#rerr').textContent = 'Passwords do not match';
          b.disabled = false;
          b.textContent = 'Reset Password';
          return;
        }

        try {
          const r = await fetch(API + '/api/admin/reset-password', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ token, password, confirmPassword }),
          });
          const j = await r.json().catch(() => ({}));
          if (!r.ok) {
            if (
              j.error &&
              (j.error.includes('expired') || j.error.includes('Invalid'))
            ) {
              $('#resetForm').hidden = true;
              $('#expiredView').hidden = false;
              return;
            }
            throw new Error(j.error || 'Failed to reset password');
          }

          $('#resetForm').hidden = true;
          $('#successView').hidden = false;
        } catch (e) {
          $('#rerr').textContent =
            e.message === 'Failed to fetch'
              ? 'Cannot reach server — try again in a few seconds.'
              : e.message;
          b.disabled = false;
          b.textContent = 'Reset Password';
        }
      }

      $('#rbtn').onclick = resetPassword;
      $('#confirmPw').addEventListener(
        'keydown',
        (e) => e.key === 'Enter' && resetPassword()
      );
    </script>
  </body>
</html>

